<!doctype html>
<html>
  <head>
    <title>Profile card</title>
  </head>
  <body>
    <section class="card">
      <h2><%= user.name %></h2>
      <p class="team"><%= user.team_name %></p>
      <p class="email"><%= user.email %></p>
      <p class="bio"><%= user.bio %></p>
    </section>
  </body>
</html>
